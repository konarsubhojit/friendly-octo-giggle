# Environment for the `DEPLOY_TARGET=self-hosted` profile.
#
# Copy to `deploy/.env.selfhost` (git-ignored) and fill in real values there.
#
# > **This repository is public.** Every value below is a placeholder. Never
# > commit a real credential, IP address, or domain name.
#
# Every provider selection below goes through `src/lib/providers/resolution.ts`.
# That module is the only place a backend is chosen; no call site reads these
# variables to decide which vendor to use. The precedence is:
#   1. an explicit selector (`CACHE_PROVIDER`, `STORAGE_PROVIDER`, ...)
#   2. credential inference (presence only — never a hostname)
#   3. the `DEPLOY_TARGET` preset
#   4. the hardcoded default
# A selector always beats the preset, and the preset only ever fills in a
# default the capability would otherwise fall back to.

# ---------------------------------------------------------------------------
# Deploy target
# ---------------------------------------------------------------------------
# Presets storage=s3, config=environment, deferred=process, analytics=none,
# jobs=inline. Also what switches `next.config.ts` to `output: 'standalone'`
# and, when the cache resolves to `redis`, wires up `src/lib/cache-handler.ts`.
DEPLOY_TARGET=self-hosted

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ---------------------------------------------------------------------------
# Database — capability `database`, selector `DATABASE_DRIVER`
# ---------------------------------------------------------------------------
# `postgres` (the `pg` pool) is the right driver for a long-lived process.
# `neon` speaks HTTP per query, which suits a serverless function that cannot
# hold a socket across invocations; on a container that runs for weeks it gives
# up connection reuse and prepared statements for nothing. Only set
# `DATABASE_DRIVER=neon` if the database genuinely is Neon *and* you want its
# serverless adapter.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://octo:<password>@127.0.0.1:5432/octo
# Optional read replica. Falls back to DATABASE_URL when unset.
# READ_DATABASE_URL=

# Pool tuning. Keep MAX_LIFETIME below any pooler's `server_idle_timeout` so the
# client discards a socket before the server does.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=20000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# DATABASE_POOL_MAX_LIFETIME_SECONDS=300

POSTGRES_USER=octo
POSTGRES_PASSWORD=<password>
POSTGRES_DB=octo

# ---------------------------------------------------------------------------
# Cache — capability `cache`, selector `CACHE_PROVIDER`
# ---------------------------------------------------------------------------
# `redis` is what makes `revalidateTag` propagate across instances, via
# `src/lib/cache-handler.ts`. With `upstash` or `none` Next.js falls back to its
# in-memory handler and a tag revalidation only affects the process that
# received the request.
CACHE_PROVIDER=redis
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Rate limit — capability `rateLimit`, selector `RATE_LIMIT_PROVIDER`
# ---------------------------------------------------------------------------
# `memory` is per-process, so limits are per-instance. Use `redis` for a shared
# counter as soon as there is more than one app container.
RATE_LIMIT_PROVIDER=redis

# ---------------------------------------------------------------------------
# Search — capability `search`, selector `SEARCH_PROVIDER`
# ---------------------------------------------------------------------------
# `postgres` runs the SQL fallback against the same database — no extra service.
SEARCH_PROVIDER=postgres

# ---------------------------------------------------------------------------
# Storage — capability `storage`, selector `STORAGE_PROVIDER`
# ---------------------------------------------------------------------------
# `s3` is the `self-hosted` preset default. The MinIO service is the S3 adapter
# pointed at a self-hosted endpoint, not a separate adapter.
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=<bucket>
S3_ACCESS_KEY_ID=<access-key>
S3_SECRET_ACCESS_KEY=<secret-key>
S3_FORCE_PATH_STYLE=true
# Public base URL images are served from. Must also appear in
# `ALLOWED_HOSTNAMES` in `workers/images/wrangler.toml`, or the image Worker
# rejects every resize for this origin.
S3_PUBLIC_BASE_URL=https://<domain>/media
MINIO_ROOT_USER=<access-key>
MINIO_ROOT_PASSWORD=<secret-key>

# ---------------------------------------------------------------------------
# Config / deferred / jobs / analytics
# ---------------------------------------------------------------------------
# All four are supplied by the `self-hosted` preset; listed for visibility.
CONFIG_PROVIDER=environment
DEFERRED_PROVIDER=process
JOBS_PROVIDER=inline
ANALYTICS_PROVIDER=none

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Behind a reverse proxy, Auth.js will not trust the forwarded host unless told
# to — without this, OAuth callbacks are built from the internal loopback
# origin and the redirect fails. Set both URL variables explicitly rather than
# relying on inference.
AUTH_TRUST_HOST=true
AUTH_URL=https://<domain>
NEXTAUTH_URL=https://<domain>
NEXT_PUBLIC_BASE_URL=https://<domain>
# openssl rand -base64 32
NEXTAUTH_SECRET=<generate-a-32-byte-random-value>

# GOOGLE_CLIENT_ID=<client-id>
# GOOGLE_CLIENT_SECRET=<client-secret>

# ---------------------------------------------------------------------------
# Email (Nodemailer)
# ---------------------------------------------------------------------------
# SMTP_HOST=<smtp-host>
# SMTP_PORT=587
# SMTP_USER=<smtp-user>
# SMTP_PASSWORD=<smtp-password>
# EMAIL_FROM=<no-reply@example.invalid>

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# SENTRY_DSN=<dsn>
# LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Published by .github/workflows/deploy-selfhost.yml.
# APP_IMAGE=ghcr.io/<owner>/<repo>:<tag>
