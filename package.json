{
  "name": "friendly-octo-giggle",
  "version": "1.0.0",
  "description": "Scalable serverless e-commerce storefront built with Next.js, TypeScript, Drizzle ORM, PostgreSQL and Redis.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --experimental-https",
    "analyze": "ANALYZE=true next build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docs:check": "node scripts/check-doc-drift.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konarsubhojit/friendly-octo-giggle.git"
  },
  "keywords": [
    "nextjs",
    "ecommerce",
    "typescript",
    "drizzle-orm",
    "postgresql",
    "redis"
  ],
  "author": "Subhojit Konar",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/konarsubhojit/friendly-octo-giggle/issues"
  },
  "homepage": "https://github.com/konarsubhojit/friendly-octo-giggle#readme",
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/drizzle-adapter": "1.11.2",
    "@azure/storage-blob": "^12.33.0",
    "@google/genai": "^2.10.0",
    "@neondatabase/serverless": "^1.1.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/nextjs": "^10.68.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@upstash/search": "^0.1.7",
    "@upstash/search-ui": "^0.1.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.7.0",
    "@vercel/edge-config": "^1.4.3",
    "@vercel/functions": "^3.7.6",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "drizzle-orm": "^0.45.2",
    "india-pincode": "^2.5.9",
    "inngest": "^4.13.0",
    "mailersend": "^2.8.0",
    "next": "^16.3.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.3.0",
    "tailwindcss": "^4.3.2",
    "web-push": "^3.6.7",
    "zenput": "^1.1.2",
    "zod": "4.4.3"
