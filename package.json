    "eslint-config-next": "^16.2.9",
    "jsdom": "^30.0.1",
    "pg": "^8.22.0",
    "prettier": "^3.8.4",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vercel": "^58.7.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7",
    "ws": "^8.21.1"
  }
}
