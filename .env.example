# Database (PostgreSQL)
# For local development without SSL: postgresql://user:password@localhost:5432/ecommerce?schema=public&sslmode=disable
# For cloud databases with SSL: postgresql://user:password@host:5432/ecommerce?schema=public
# Note: The app accepts self-signed certificates by default for compatibility with development/cloud databases
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce?schema=public

# Provider selectors (all optional).
# Each capability picks its backend from the selector below; when a selector is
# unset the provider is inferred from which credentials are present, so an
# existing deployment keeps the backend it already uses. Resolution lives in
# src/lib/providers/resolution.ts — nothing else in the app reads these.
# DATABASE_DRIVER=neon               # postgres | neon
# CACHE_PROVIDER=upstash             # redis | upstash | none
# SEARCH_PROVIDER=postgres           # postgres | algolia | upstash
# STORAGE_PROVIDER=vercel            # s3 | vercel | r2
# RATE_LIMIT_PROVIDER=upstash        # redis | upstash | memory
# CONFIG_PROVIDER=environment        # environment | edge-config
# JOBS_PROVIDER=inngest              # inngest | inline

# Redis Connection
# Option A: Upstash REST (edge-safe, serverless)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
# Option B: Standard Redis (Node server only, requires CACHE_PROVIDER=redis)
# REDIS_URL=redis://localhost:6379

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Base URL for client-side links (optional)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth (Personal Accounts Only — register at Azure Portal)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Image storage: STORAGE_PROVIDER selects the write/read-primary backend.
# Defaults to "vercel" when unset. Reads try other *configured* providers when
# an object is missing from the primary one (see src/lib/storage/index.ts's
# resolveStorageUrl), so cutovers can happen before every historical object has
# been copied.
# STORAGE_PROVIDER=vercel
# Optional fallback order (comma-separated): global + per-primary overrides.
# Unconfigured providers in these lists are skipped without being contacted.
# STORAGE_FALLBACK_PROVIDERS=r2,vercel
# STORAGE_FALLBACK_VERCEL=r2,s3
# STORAGE_FALLBACK_R2=vercel,s3
# STORAGE_FALLBACK_S3=r2,vercel

# Vercel Blob (default image storage provider)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Cloudflare R2 (S3-compatible API via @aws-sdk/client-s3) — accepted as a
# backward-compatible alias and used as the "r2" preset. Create an R2 API token
# with Object Read & Write
# permissions in the Cloudflare dashboard.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=your-r2-bucket-name
# R2_PUBLIC_BASE_URL=https://your-bucket-public-domain.example.com

# Generic S3-compatible storage — required when STORAGE_PROVIDER=s3. Works with
# any S3 protocol implementation (AWS S3, MinIO, Cloudflare R2, DigitalOcean
# Spaces, Backblaze B2, Wasabi, Ceph, Garage). S3_ENDPOINT and
# S3_FORCE_PATH_STYLE are optional; set both for self-hosted implementations.
# S3_REGION=us-east-1
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_PUBLIC_BASE_URL=https://your-bucket-public-domain.example.com
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=true
# S3_CA_CERT_PEM=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----  # Optional CA bundle for local/self-hosted TLS

# Deprecated R2_* aliases are still accepted for S3 migration compatibility.

# Algolia search — required when SEARCH_PROVIDER=algolia.
# ALGOLIA_APP_ID=your-algolia-app-id
# ALGOLIA_ADMIN_API_KEY=your-algolia-admin-api-key
# ALGOLIA_PRODUCTS_INDEX=friendly-products-development
# ALGOLIA_SEARCH_API_KEY=your-algolia-search-only-key
# Searches are server-mediated; never expose ALGOLIA_ADMIN_API_KEY in client code.
# ALGOLIA_API_KEY and ALGOLIA_INDEX_NAME remain supported as legacy aliases.

# Cloudflare Worker (workers/images) that resizes images at the edge via
# cf.image. When unset, next/image's custom loader (src/lib/image-loader.ts)
# returns the source URL unchanged (unoptimized, but images still render).
# NEXT_PUBLIC_IMAGE_WORKER_URL=https://your-images-worker.example.workers.dev

# Exchange Rate API (https://www.exchangerate-api.com/)
# Used for live currency conversion rates. Falls back to hardcoded rates if not set.
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# Logging
# debug | info | warn | error
LOG_LEVEL=info

# MailerSend Email (https://www.mailersend.com/)
# Required for order confirmation & status update emails
MAILERSEND_API_KEY=your-mailersend-api-key
MAILERSEND_FROM_EMAIL=noreply@yourdomain.com

# Google SMTP Email (preferred when configured)
# For Gmail, use a Google App Password (requires 2FA enabled)
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=465
GOOGLE_SMTP_SECURE=true
GOOGLE_SMTP_USER=your-gmail-address@gmail.com
GOOGLE_SMTP_APP_PASSWORD=your-google-app-password
GOOGLE_SMTP_FROM_EMAIL=noreply@yourdomain.com

# Upstash Search (https://console.upstash.com/ → Search)
# Used for full-text search on products and orders
UPSTASH_SEARCH_REST_URL=https://your-upstash-search-url
UPSTASH_SEARCH_REST_TOKEN=your-upstash-search-token
UPSTASH_SEARCH_REST_READONLY_TOKEN=your-upstash-search-readonly-token

# Client-side search (safe to expose — readonly token)
NEXT_PUBLIC_UPSTASH_SEARCH_REST_URL=https://your-upstash-search-url
NEXT_PUBLIC_UPSTASH_SEARCH_REST_READONLY_TOKEN=your-upstash-search-readonly-token

# Playwright E2E Testing (credentials for authenticated test flows)
COPILOT_DEV_EMAIL=your-test-account@example.com
COPILOT_DEV_PASS=your-test-account-password
# Sentry Error Monitoring (https://sentry.io/)
# Optional — Sentry is disabled when not set.
# When using the Vercel ↔ Sentry integration, these variables are injected
# automatically (only NEXT_PUBLIC_SENTRY_DSN is required at runtime; the rest
# are used during the build for source-map upload and release tagging).
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Web Push (VAPID) — order-status notifications through the PWA service worker
# Optional. Push is disabled and the account preference centre reports it as
# unavailable when the key pair is not set.
# Generate a key pair once with:
#   npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY secret; rotating it invalidates every existing
# browser subscription and customers must opt in again.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI sent to push services (mailto: or https:). Defaults to a
# placeholder mailto address when unset.
VAPID_SUBJECT=mailto:support@yourdomain.com

# Inngest (durable checkout orchestration)
# Optional: without these the checkout pipeline stays on Vercel Queues.
# Setting INNGEST_EVENT_KEY requires INNGEST_SIGNING_KEY.
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
